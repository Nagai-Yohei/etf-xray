# SEC EDGAR API User-Agent (required by SEC fair-access policy)
# Format: "AppName contact@example.com"
# Set real values only in your local .env (gitignored); never commit .env.
SEC_USER_AGENT="etf-xray your-name@example.com"

# OpenFIGI API key (optional; raises rate limits when set)
OPENFIGI_API_KEY=""

# Cloudflare Pages Direct Upload (only needed for ./run.sh deploy)
# Use a scoped API token with only Account -> Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PAGES_PROJECT="etf-xray"
