#!/usr/bin/env bash
# Git pre-commit hook: blocks secrets, personal info, and ignored files from being committed
# Enable: git config core.hooksPath scripts
# Manual check: ./scripts/pre-commit --files <files...>

set -euo pipefail

MODE="staged"
if [ "${1:-}" = "--files" ]; then
  MODE="files"
  shift
fi

if [ "$MODE" = "staged" ]; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"
else
  REPO_ROOT="$(pwd)"
fi

ERRORS=0

fail() {
  echo "[pre-commit] BLOCKED: $1" >&2
  ERRORS=$((ERRORS + 1))
}

# Split parts of pattern strings to avoid self-matching this script
PAT_PRIVATE_KEY="-----BEGIN"" [A-Z0-9 ]*PRIVATE KEY-----"
PAT_GITHUB_TOKEN="(gh[pousr]""_[A-Za-z0-9]{20,}|github_""pat_[A-Za-z0-9_]{20,})"
PAT_AWS_KEY="AK""IA[0-9A-Z]{16}"
PAT_GOOGLE_KEY="AI""za[0-9A-Za-z_-]{35}"
PAT_SLACK_TOKEN="xo""x[baprs]-[A-Za-z0-9-]{10,}"
PAT_SK_TOKEN="s""k-[A-Za-z0-9]{20,}"
PAT_ENV_SECRET="(CLOUDFLARE_API_TOKEN|OPENFIGI_API_KEY|GITHUB_TOKEN|CF_API_TOKEN)[[:space:]]*=[[:space:]]*[\"']?[A-Za-z0-9._-]{16,}"
PAT_UNSAFE_DOM="(inner""HTML|outer""HTML|insertAdjacent""HTML)"
PAT_EXTERNAL_CDN="https?://(cdn\.|cdnjs\.|unpkg\.com|cdn\.jsdelivr\.net|ajax\.googleapis\.com)"

# Collect secret values (e.g. SEC_USER_AGENT) from env and .env without printing them
SECRET_VALUES=()
SECRET_COUNT=0

add_secret_value() {
  local val="$1"
  # Trim surrounding whitespace and quotes
  val="${val#"${val%%[![:space:]]*}"}"
  val="${val%"${val##*[![:space:]]}"}"
  val="${val#\"}"
  val="${val%\"}"
  val="${val#\'}"
  val="${val%\'}"

  # Skip empty, very short, or placeholder values (e.g. example.com)
  if [ "${#val}" -lt 6 ]; then
    return
  fi
  if printf '%s' "$val" | grep -Eiq '@example\.(com|org|net)|your-name|changeme|dummy'; then
    return
  fi
  SECRET_VALUES+=("$val")
  SECRET_COUNT=$((SECRET_COUNT + 1))
}

if [ -n "${SEC_USER_AGENT:-}" ]; then
  add_secret_value "$SEC_USER_AGENT"
fi

if [ -f "$REPO_ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
      SEC_USER_AGENT=*|OPENFIGI_API_KEY=*|CLOUDFLARE_API_TOKEN=*|GITHUB_TOKEN=*)
        add_secret_value "${line#*=}"
        ;;
    esac
  done < "$REPO_ROOT/.env"
fi

CURRENT_USER="$(id -un 2>/dev/null || true)"

check_path() {
  local file="$1"
  # 1. Check forbidden / ignored file paths
  case "$file" in
    .env|.env.*)
      if [ "$file" != ".env.example" ]; then
        fail "Environment file cannot be committed: $file"
      fi
      ;;
    data/*|dist/*|.venv/*|venv/*|.wrangler/*|__pycache__/*|*/__pycache__/*)
      fail "Files under ignored directories cannot be committed: $file"
      ;;
    *.db|*.db-journal|*.db-shm|*.db-wal|*.sqlite|*.sqlite3)
      fail "Database files cannot be committed: $file"
      ;;
    *.pem|*.key|*.p12|*.pfx|*.crt|*.jks|id_rsa|id_rsa.*|*/id_rsa|*/id_rsa.*|id_ed25519|id_ed25519.*|*/id_ed25519|*/id_ed25519.*)
      fail "Private key or certificate files cannot be committed: $file"
      ;;
    .DS_Store|*/.DS_Store)
      fail "OS temporary files cannot be committed: $file"
      ;;
  esac
}

check_content() {
  local file="$1"
  local content="$2"

  # 2. Check private keys and API token patterns
  if printf '%s\n' "$content" | grep -Eq -e "$PAT_PRIVATE_KEY"; then
    fail "Private key header detected: $file"
  fi
  if printf '%s\n' "$content" | grep -Eq -e "$PAT_GITHUB_TOKEN"; then
    fail "GitHub token pattern detected: $file"
  fi
  if printf '%s\n' "$content" | grep -Eq -e "$PAT_AWS_KEY"; then
    fail "AWS access key pattern detected: $file"
  fi
  if printf '%s\n' "$content" | grep -Eq -e "$PAT_GOOGLE_KEY"; then
    fail "Google API key pattern detected: $file"
  fi
  if printf '%s\n' "$content" | grep -Eq -e "$PAT_SLACK_TOKEN"; then
    fail "Slack token pattern detected: $file"
  fi
  if printf '%s\n' "$content" | grep -Eq -e "$PAT_SK_TOKEN"; then
    fail "API secret key pattern (sk-...) detected: $file"
  fi
  if [ "$file" != ".env.example" ] && printf '%s\n' "$content" | grep -Eq -e "$PAT_ENV_SECRET"; then
    fail "Hardcoded API token assignment detected: $file"
  fi

  # 3. Check email addresses (RFC-reserved example.com/org/net are allowed)
  local email_hits
  email_hits="$(printf '%s\n' "$content" \
    | grep -Eo -e '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
    | grep -Eiv -e '@example\.(com|org|net)$' || true)"
  if [ -n "$email_hits" ]; then
    fail "Email address detected (only example.com/org/net placeholders are allowed): $file"
  fi

  # 4. Check local absolute paths (allow documentation placeholders like /Users/...)
  local unix_path_hits
  unix_path_hits="$(printf '%s\n' "$content" \
    | grep -Eo -e '/(Users|home)/[A-Za-z0-9._-]+' \
    | grep -Ev -e '^/(Users|home)/\.\.\.$' || true)"
  if [ -n "$unix_path_hits" ]; then
    fail "Local absolute path (/Users/ or /home/) detected: $file"
  fi

  local win_path_hits
  win_path_hits="$(printf '%s\n' "$content" \
    | grep -Eio -e '[A-Za-z]:\\Users\\[A-Za-z0-9._-]+' \
    | grep -Eiv -e '^[A-Za-z]:\\Users\\\.\.\.$' || true)"
  if [ -n "$win_path_hits" ]; then
    fail "Windows local absolute path detected: $file"
  fi

  if [ -n "$CURRENT_USER" ] && [ "${#CURRENT_USER}" -ge 3 ]; then
    if printf '%s\n' "$content" | grep -Fq -- "/Users/$CURRENT_USER"; then
      fail "Path containing the current local username detected: $file"
    fi
  fi

  # 5. Check exact matches against secret values from env/.env (never print values)
  if [ "$SECRET_COUNT" -gt 0 ]; then
    local secret
    for secret in "${SECRET_VALUES[@]}"; do
      if printf '%s\n' "$content" | grep -Fq -- "$secret"; then
        fail "Secret value from environment variables or .env detected: $file"
      fi
    done
  fi

  # 6. Frontend security check (under web/, excluding bundled web/vendor/)
  case "$file" in
    web/vendor/*)
      ;;
    web/*)
      if printf '%s\n' "$content" | grep -Eq -e "$PAT_UNSAFE_DOM"; then
        fail "Forbidden unsafe DOM API detected (XSS prevention): $file"
      fi
      if printf '%s\n' "$content" | grep -Eiq -e "$PAT_EXTERNAL_CDN"; then
        fail "External CDN script reference detected (bundle locally under web/vendor/): $file"
      fi
      ;;
  esac
}

if [ "$MODE" = "staged" ]; then
  while IFS= read -r -d '' file; do
    [ -z "$file" ] && continue
    check_path "$file"
    if ! git show ":$file" 2>/dev/null | grep -Iq .; then
      continue
    fi
    content="$(git show ":$file")"
    check_content "$file" "$content"
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)
else
  for file in "$@"; do
    check_path "$file"
    if [ ! -f "$file" ]; then
      continue
    fi
    if ! grep -Iq . "$file" 2>/dev/null; then
      continue
    fi
    content="$(cat "$file")"
    check_content "$file" "$content"
  done
fi

if [ "$ERRORS" -gt 0 ]; then
  echo "[pre-commit] Commit aborted: ${ERRORS} issue(s) detected." >&2
  exit 1
fi

exit 0
